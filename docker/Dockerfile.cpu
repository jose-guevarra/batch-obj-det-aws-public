# CPU worker image: python -m detector.worker
# Built by CDK (DockerImageAsset, linux/amd64) from the repo root:
#   docker buildx build --platform linux/amd64 -f docker/Dockerfile.cpu .

FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

# The requirement list, exported from uv.lock in its own stage. The main stage copies only
# this file, and BuildKit keys a COPY on file content, so a lockfile change that leaves the
# ml group alone (API or UI dependencies) keeps the install layer cached.
# torch's CUDA dependencies (nvidia-*, cuda-*, triton) and the ONNX / TensorRT packages
# (GPU runtimes only) are dropped; nvidia-ml-py stays (ultralytics imports it).
FROM python:3.14-slim-bookworm AS reqs
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-default-groups --group ml --no-emit-project --no-hashes \
        --no-emit-package torch --no-emit-package torchvision -o /tmp/all.txt \
    && { grep -E '^nvidia-ml-py==' /tmp/all.txt; grep -vE '^(nvidia-|cuda-|triton==|onnxruntime-gpu==|tensorrt-|onnx==|onnxslim==)' /tmp/all.txt; } \
        > /requirements.txt

FROM python:3.14-slim-bookworm

# OpenCV (pulled in by ultralytics as opencv-python) needs libGL and glib at import time.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1

WORKDIR /app

# 1. torch and torchvision from PyTorch's CPU-only index, at the versions in uv.lock.
#    The PyPI wheels bundle about 2.5 GB of CUDA libraries a CPU worker never uses.
RUN uv pip install --index-url https://download.pytorch.org/whl/cpu \
    torch==2.15.0 torchvision==0.29.2

# 2. Everything else in the ml group, pinned by uv.lock (see the reqs stage).
#    --no-deps installs exactly this list, so nothing re-pulls the CUDA build of torch.
COPY --from=reqs /requirements.txt /tmp/requirements.txt
RUN uv pip install --no-deps -r /tmp/requirements.txt

# 3. Weights, checked against a known hash so the image is reproducible.
# The directory exists first: ADD --chmod would otherwise create it without search permission.
RUN mkdir -m 0755 /app/models
ADD --chmod=0644 --checksum=sha256:5d4a90cdc7a21786cc59cd19778e9eafff836df9e2da32524737c7ee6efe4fe5 \
    https://github.com/ultralytics/assets/releases/download/v8.4.0/yolov8m.pt \
    /app/models/yolov8m.pt

# 4. The detector package itself (its dependencies are already installed).
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN uv pip install --no-deps .

ENV MODELS_DIR=/app/models \
    YOLO_OFFLINE=1 \
    YOLO_CONFIG_DIR=/tmp/ultralytics \
    PYTHONUNBUFFERED=1 \
    DEVICE=cpu

# Fail the build, not the first task, if imports or the CPU-only torch are wrong.
RUN python -c "import torch, cv2, detector.worker; assert not torch.cuda.is_available(); print('torch', torch.__version__)"

RUN useradd --create-home --uid 10001 worker
USER worker

CMD ["python", "-m", "detector.worker"]
