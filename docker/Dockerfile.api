# Lambda image for the status API, finalize and unzip functions (arm64, no torch):
#   detector.api.handler        FastAPI through Mangum (API Gateway proxy)
#   detector.finalize.handler   combine part files, write the summary (async invoke)
#   detector.unzip.handler      upload/{batch_id}/*.zip -> input/{batch_id}/ (S3 event)
# The three functions share this image and pick their handler with CMD.
# Built by CDK (DockerImageAsset, linux/arm64) from the repo root:
#   docker buildx build --platform linux/arm64 -f docker/Dockerfile.api .

FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

# Requirements from uv.lock: the api group (with boto3), plus numpy and OpenCV at the ml
# group's versions. OpenCV is the headless build: the Lambda base image has no libGL, and
# the API only draws boxes and encodes JPEGs.
FROM public.ecr.aws/lambda/python:3.14 AS reqs
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-default-groups --group api --no-emit-project --no-hashes \
        -o /tmp/api.txt \
    && uv export --frozen --no-default-groups --group ml --no-emit-project --no-hashes \
        -o /tmp/ml.txt \
    && { grep -E '^[a-z0-9]' /tmp/api.txt; \
         grep -E '^numpy==' /tmp/ml.txt; \
         grep -E '^opencv-python==' /tmp/ml.txt | sed 's/^opencv-python==/opencv-python-headless==/'; } \
        > /requirements.txt

FROM public.ecr.aws/lambda/python:3.14

COPY --from=reqs /requirements.txt /tmp/requirements.txt
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    UV_NO_CACHE=1 uv pip install --no-deps --python /var/lang/bin/python3 \
        --target "${LAMBDA_TASK_ROOT}" -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY src/detector/ ${LAMBDA_TASK_ROOT}/detector/

CMD ["detector.api.handler"]
